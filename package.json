{
  "name": "canal-studio",
  "version": "1.0.0",
  "description": "Produção de vídeos para YouTube, local e gratuita",
  "main": "./out/main/index.js",
  "author": "Gabriel",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:remotion",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "check-setup": "powershell -ExecutionPolicy Bypass -File scripts/check-setup.ps1",
    "test": "vitest run",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "typecheck:remotion": "tsc --noEmit -p tsconfig.remotion.json --composite false",
    "test:live": "vitest run --config vitest.live.config.ts",
    "deploy:desktop": "powershell -ExecutionPolicy Bypass -File scripts/deploy-desktop.ps1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@googleapis/youtube": "^40.0.0",
    "@googleapis/youtubeanalytics": "^11.0.1",
    "@remotion/bundler": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "better-sqlite3": "^13.0.3",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "^4.0.533",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright": "^1.63.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "productName": "Canal Studio"
}
